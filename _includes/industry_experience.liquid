<section class="mb-4" aria-labelledby="industry-experience">
  <h2 id="industry-experience">Industry Experience</h2>
  {% for entry in site.data.resume.work %}
    <div class="mt-3">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline">
        <h3 class="h5 font-weight-bold mb-1">{{ entry.name }}</h3>
        <span class="text-muted">
          {{- entry.startDate | append: '-01' | date: '%b %Y' }} &ndash; {{ entry.endDate | append: '-01' | date: '%b %Y' -}}
        </span>
      </div>
      <p class="mb-1">{{ entry.position }} &middot; {{ entry.summary }}</p>
      <p class="text-muted mb-2">{{ entry.location }}</p>
      <ul>
        {% for highlight in entry.highlights %}
          <li>{{ highlight | markdownify | remove: '<p>' | remove: '</p>' }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</section>
